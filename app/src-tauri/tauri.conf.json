{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Board",
  "version": "0.3.0",
  "identifier": "io.github.kiranpothana.session-board",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "board",
        "title": "Session Board",
        "width": 400,
        "height": 640,
        "minWidth": 280,
        "minHeight": 120,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "toasts",
        "url": "toasts.html",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://session-board-reports.kiran-987.workers.dev"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
