{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Board",
  "version": "0.2.0",
  "identifier": "io.github.kiranpothana.session-board",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "board",
        "title": "Session Board",
        "width": 400,
        "height": 640,
        "minWidth": 280,
        "minHeight": 120,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
